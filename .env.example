# Base URL for the Bloom Growth API. Override only if Bloom gives you a
# different host. The default works for standard accounts.
BLOOM_API_BASE_URL=https://app.bloomgrowth.com

# Secret used to sign/encrypt the session cookie that holds the Bloom token.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
