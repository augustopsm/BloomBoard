# Base URL for the Bloom Growth API. Override only if Bloom gives you a
# different host. The default works for standard accounts.
BLOOM_API_BASE_URL=https://app.bloomgrowth.com

# Secret used to sign/encrypt the session cookie that holds the Bloom token.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Asana integration (optional) ──────────────────────────────────────────
# Enables the "+ Asana" button on each card, which creates an Asana task.
# Personal Access Token: Asana → Settings → Apps → Developer apps →
#   Manage Personal Access Tokens → Create new token.
ASANA_ACCESS_TOKEN=
# The gid of the project new tasks are added to. Find it in the project URL:
#   https://app.asana.com/0/<PROJECT_ID>/list
ASANA_PROJECT_ID=
# Optional fallback if you don't set a project (tasks land loose in the workspace).
# ASANA_WORKSPACE_ID=
